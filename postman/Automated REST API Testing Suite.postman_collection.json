          "listen": "test",
          "script": {
            "exec": [
              "const data = pm.response.json();",
              "",
              "pm.test(\"Post 1 is consistent across endpoints\", function () {",
              "    const post = data.find(function (item) {",
              "        return item.id === 1;",
              "    });",
              "",
              "    pm.expect(post).to.exist;",
              "",
              "    const savedTitle = pm.collectionVariables.get(\"postTitle\");",
              "    const savedBody = pm.collectionVariables.get(\"postBody\");",
              "",
              "    pm.expect(post.title).to.eql(savedTitle);",
              "    pm.expect(post.body).to.eql(savedBody);",
              "});"
