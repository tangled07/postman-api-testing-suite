  "item": [
    {
      "name": "GET Valid Post",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Response contains the expected post\", function () {",
              "    const data = pm.response.json();",
              "",
              "    pm.expect(data.id).to.eql(1);",
              "    pm.expect(data.title).to.be.a(\"string\");",
              "    pm.expect(data.body).to.be.a(\"string\");",
              "});",
              "pm.test(\"Post data has valid fields\", function () {",
              "    const data = pm.response.json();",
              "",
              "    pm.expect(data.id).to.be.a(\"number\");",
              "    pm.expect(data.userId).to.be.a(\"number\");",
              "    pm.expect(data.title).to.be.a(\"string\").and.not.empty;",
              "    pm.expect(data.body).to.be.a(\"string\").and.not.empty;",
              "});",
              "pm.test(\"Response time is under 1000 ms\", function () {",
              "    pm.expect(pm.response.responseTime).to.be.below(1000);",
              "});",
              "const data = pm.response.json();",
              "",
              "pm.collectionVariables.set(\"postTitle\", data.title);",
              "pm.collectionVariables.set(\"postBody\", data.body);"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
